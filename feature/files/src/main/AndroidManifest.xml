<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- T11.1 "Share" out of the file browser: a read grant on ONE downloaded copy under
             cache/workspace-files/share/ (see res/xml/workspace_file_paths.xml), handed to the
             app the user picks. Not exported; access only through the per-intent URI grant.
             Its own subclass so it never collides with another library's FileProvider. -->
        <provider
            android:name="com.tether.app.ui.files.WorkspaceFileProvider"
            android:authorities="${applicationId}.workspacefiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <!-- Also named here (the subclass passes it too) so getUriForFile resolves the paths
                 even before this provider instance is attached. -->
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/workspace_file_paths" />
        </provider>

        <!-- ta-coik.67 "Take photo" in the Upload chooser: a write grant on ONE capture file under
             cache/workspace-capture/ (res/xml/workspace_capture_paths.xml), handed to the camera
             app through ACTION_IMAGE_CAPTURE. Its own provider, apart from the read-only share one.
             Not exported; access only through the per-intent URI grant. No CAMERA permission is
             declared (the camera app holds its own). -->
        <provider
            android:name="com.tether.app.ui.files.WorkspaceCaptureProvider"
            android:authorities="${applicationId}.workspacecapture"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/workspace_capture_paths" />
        </provider>
    </application>

</manifest>
