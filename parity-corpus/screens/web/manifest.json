      "name": "health-log",
      "notes": "",
      "unsupportedReason": "the Health & Event Log dialog is live process telemetry — server pid, RSS/heap, uptime and a connection-event list whose length and order follow the browser's reconnects — so it cannot be made pixel-stable without masking most of it (the fake engine's warnings are not in it either: WARNINGS LOGGED stays 0)"
    },
    {
      "name": "question-pending",
      "notes": "",
      "unsupportedReason": "the fake engine has no question step: it can only emit approval_request, never question_request (engines/fake-engine.mjs step list); an AskUserQuestion approval renders as a suppressed tool, not a QuestionCard"
    },
    {
      "name": "rate-limit",
      "notes": "",
      "unsupportedReason": "no fake-engine step emits `rate_limit` (only Claude's rate_limit_event / Codex usage-limit adapters do), so neither the limit banner nor the resume-choice state can be reached"
    },
    {
      "name": "model-fallback",
      "notes": "",
      "unsupportedReason": "no fake-engine step emits `model_fallback` (only the Claude system/model_fallback adapter does)"
    },
    {
      "name": "wrap-up",
      "notes": "",
      "unsupportedReason": "the Wrap-Up Allowance is the `grace` field of a `rate_limit` event, which the fake engine cannot emit"
    },
    {
      "name": "streaming-text-caret",
      "notes": "",
      "unsupportedReason": "the fake `message` step emits started+delta+completed back-to-back, so a message block that is still receiving deltas (the live text caret) cannot be frozen; `streaming` shows a frozen turn with an open tool call instead"
    }
  ],
  "pathPlaceholders": "`{name}` in a path is the id of the session seeded for that scenario (random per run)",
  "masks": [
    {
      "kind": "text-scrub",
      "target": "any text node containing a seeded session id",
      "replacement": "sess-XXXXXXXXX padded with X to the id's 14 chars",
      "reason": "session ids are random per run and appear verbatim in handoff briefs"
    },
    {
      "kind": "text-scrub",
      "target": ".chat-activity-verb",
      "replacement": "Working…",
      "reason": "the live activity verb is picked by hashing the random turn id (lib/spinner-words.mjs)"
    }
  ],
  "removedElements": [
    {
      "selector": "nextjs-portal",
      "reason": "Next.js dev-mode overlay (the \"N · Issues\" badge); the harness runs `next dev`, and the overlay is not part of the app"
    }
  ],
  "determinism": {
    "browserClock": "Playwright clock.setFixedTime(<phase start> + 600500 ms); timezone UTC, locale en-US, colorScheme light, reducedMotion reduce",
    "serverClock": "scripts/parity-clock.mjs: phase k starts at 2026-01-01T00:00:00Z + k h + k·100 ms, runs at 0.001x real time, and steps +60 s (SIGUSR2) before every seeded session, so sessions never share a timestamp",
    "phases": [
      "live",
      "echo",
      "markdown",
      "tools",
      "codex-tools",
      "subagents",
      "notices",
      "main"
    ],
    "freezeCss": "*, *::before, *::after {\n  animation-duration: 0s !important;\n  animation-delay: 0s !important;\n  animation-iteration-count: 1 !important;\n  transition-duration: 0s !important;\n  transition-delay: 0s !important;\n  caret-color: transparent !important;\n}",
    "screenshot": "animations: disabled, caret: hide, retaken until two consecutive captures are identical",
    "waits": "each session shot waits for the page's own session-controls and server-settings replies (observed by an in-page WebSocket message listener); when next dev's StrictMode double-connect dropped the app's one-shot server-settings request, the harness re-sends that same ClientMessage on the app's open /ws socket"
  }
}
