<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup + device-to-device transfer rules (android:dataExtractionRules,
     API 31+). Credentials never leave the device:
     - files/credentials/ holds the Keystore-sealed tether_session cookie and
       tthr_ device token. A sealed blob is useless off-device (the Keystore key
       is never backed up), but it is excluded anyway: a restored blob would only
       read as "logged out", and nothing about a credential belongs in a backup.
     - files/tether_settings.preferences_pb held those credentials in PLAINTEXT
       before T1.4. An install that was upgraded but not yet launched has not
       migrated them yet, so the whole file (and DataStore's .tmp sibling) is
       excluded too. It holds only the server URL and unsent input otherwise.
     - shared_prefs/com.google.android.gms.appid.xml is where firebase-messaging
       keeps the FCM registration token (T12.1), a credential-grade push
       identifier bound to this device's registration. (Its -no-backup sibling
       already lives in no_backup/.) Firebase Installations' file is named
       after the app id, which comes from the server at runtime, so it has no
       fixed path to exclude here.
     - shared_prefs/tether_push_firebase.xml binds the accepted Firebase project
       to the server origin it came from (T12.1). It is excluded with the token,
       so a restored install never inherits a push identity.
     - files/datastore/tether_drafts.preferences_pb holds unsent composer text
       per server origin (T2.3/T7.1): user content, like the unsent input in the
       settings file, so it stays on this device too.
     - databases/ (the whole domain) holds the T13.1 journal mirror: session
       transcripts, row-sealed under a data key whose Keystore wrapper never leaves
       the device. It is a cache rebuilt from the server, so nothing is lost by
       excluding it, and a transcript copy has no business in a backup
       (SYNC_DESIGN §8.4). Its wrapped data key lives in no_backup/.
     Keep this in sync with backup_rules.xml (android:fullBackupContent). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="credentials" />
        <exclude domain="file" path="tether_settings.preferences_pb" />
        <exclude domain="file" path="tether_settings.preferences_pb.tmp" />
        <exclude domain="file" path="datastore/tether_drafts.preferences_pb" />
        <exclude domain="file" path="datastore/tether_drafts.preferences_pb.tmp" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="sharedpref" path="tether_push_firebase.xml" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="credentials" />
        <exclude domain="file" path="tether_settings.preferences_pb" />
        <exclude domain="file" path="tether_settings.preferences_pb.tmp" />
        <exclude domain="file" path="datastore/tether_drafts.preferences_pb" />
        <exclude domain="file" path="datastore/tether_drafts.preferences_pb.tmp" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="sharedpref" path="tether_push_firebase.xml" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
