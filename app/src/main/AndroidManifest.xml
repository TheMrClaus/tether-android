<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Runtime permission for posting notifications (every supported API level,
         minSdk 34). Requested from the settings sheet the first time the user
         enables notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 17 (API 37) runtime permission, NEARBY_DEVICES group. With
         targetSdk 37 the OS blocks traffic to the local network without it, and
         Tether servers are often self-hosted on the LAN. Requested (with an
         in-app explanation first) only when the configured server is local, and
         only on API 37+. Below 37 INTERNET implies local access and the
         declaration is inert. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Backup stays on for UI preferences, but credentials never leave the
         device: see res/xml/data_extraction_rules.xml (Auto Backup + device
         transfer, API 31+) and res/xml/backup_rules.xml (fullBackupContent). -->
    <application
        android:name=".TetherApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:theme="@style/Theme.Tether"
        android:supportsRtl="true">

        <!-- singleTask (T4.4): a link from another app reaches the one existing
             instance through onNewIntent instead of stacking a second copy of
             the app in the caller's task; Back then leaves Tether, as the web's
             replaceState keeps Back meaning "leave the console". -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Tap on a notification FCM showed while the app was in the
                 background: the server sets android.notification.click_action
                 "OPEN_TETHER" (tether lib/fcm-push.mjs), and FCM starts this
                 action with the data map as extras. Without this filter the tap
                 resolves no activity and does nothing. The activity is already
                 exported (launcher), so this adds no new entry point.
                 push/PushDeepLink.parse treats the extras as untrusted. -->
            <intent-filter>
                <action android:name="OPEN_TETHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- T4.4: tether://session/<id> opens that session. Navigation only;
                 nav/DeepLinks validates the id and nav/DeepLinkNavigator routes it.
                 There is deliberately NO http(s) filter and so no autoVerify: the
                 paired server's origin differs per install, and a manifest host
                 cannot name it (verified App Links would also need S10.1's
                 assetlinks.json on that host). An explicit http(s) intent is still
                 honoured for the paired origin only. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tether" android:host="session" />
            </intent-filter>
        </activity>

        <!-- FCM message receiver. exported=false: only the FCM system service
             (same APK signature) may start it. The service posts the visible
             server kinds (approval / question / turn_end / resume_choice) on
             their own channels and ignores the data-only sync hint. -->
        <service
            android:name=".push.TetherFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Channel and icon for notifications FCM shows itself (app in the
             background). The server sends no channel_id, so without this they
             would land in FCM's "Misc" fallback channel. push/PushChannels
             creates the channel at startup. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tether-general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@android:drawable/stat_notify_chat" />
    </application>

</manifest>
